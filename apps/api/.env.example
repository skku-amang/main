# Database (required)
# Port 5433: docker-compose maps host 5433 → container 5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/amang_db

# JWT secrets (required)
ACCESS_TOKEN_SECRET=dev-access-token-secret
REFRESH_TOKEN_SECRET=dev-refresh-token-secret

# Token expiration in seconds
ACCESS_TOKEN_EXPIRES_IN_SECONDS=3600
REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800

# Object storage / MinIO (required)
S3_BUCKET=amang
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
# S3_REGION=ap-northeast-2  # default: ap-northeast-2

# Auth cookie (ADR-0002). 로컬은 둘 다 미설정 — host-only + SameSite=Lax
# COOKIE_DOMAIN=amang.json-server.win   # web·api 서브도메인 공유 (prod/staging overlay에서 설정)
# COOKIE_SAMESITE=none                  # staging 전용: Vercel preview 로그인 허용

# Server port (default: 8000)
# PORT=8000

# Redis (use case 미정 — 의존성/모듈 등록 후 required 전환 예정)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis

# Sentry DSN (error tracking, disabled in development by default)
# SENTRY_DSN=https://xxx@xxx.ingest.us.sentry.io/xxx
