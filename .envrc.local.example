# Claude Code MCP 토큰 설정
# 이 파일을 .envrc.local로 복사한 후 토큰을 채워주세요.
# cp .envrc.local.example .envrc.local

# Notion: https://www.notion.so/profile/integrations 에서 아망 워크스페이스 Internal Integration 생성
export NOTION_TOKEN=ntn_xxx

# Slack: 팀 공용 봇 토큰 — 장수에게 문의
export SLACK_BOT_TOKEN=xoxb-xxx

# Sentry: https://sentry.io/settings/account/api/auth-tokens/ 에서 User Auth Token 생성
# scope: org:read, project:read, event:read, issue:read
export SENTRY_ACCESS_TOKEN=sntryu_xxx

# Grafana MCP (https://grafana.json-server.win → Administration → Service accounts → Add service account token)
# 설치: go install github.com/grafana/mcp-grafana/cmd/mcp-grafana@latest
# TODO: 추후 MCP 전용 Service Account 분리 (현재는 개인 토큰 사용)
export GRAFANA_URL=https://grafana.json-server.win
export GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_xxx

# ArgoCD ai-agent (보기 + sync). 토큰 발급: homelab k8s/argocd/README.md "AI account token"
# --config: ~/.config/argocd/config가 있으면 env 토큰이 무시되므로 없는 경로를 지정
export ARGOCD_SERVER=argocd.json-server.win
export ARGOCD_AUTH_TOKEN=
export ARGOCD_OPTS="--grpc-web --config $HOME/.config/argocd/ai-agent.none"

# Kargo ai-agent (보기 + 승격). 토큰: infra/kargo/ai-agent.yaml의 Secret을 쿠버네티스가 채움
# kubectl --context json -n amang get secret ai-agent-token -o jsonpath='{.data.token}' | base64 -d
export KARGO_API_ADDRESS=https://kargo.json-server.win
export KARGO_API_TOKEN=
